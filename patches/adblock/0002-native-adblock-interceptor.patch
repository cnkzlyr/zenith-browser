--- a/services/network/url_loader.cc
+++ b/services/network/url_loader.cc
@@ -112,6 +112,18 @@ void URLLoader::Start(
     mojo::PendingReceiver<mojom::URLLoader> receiver,
     mojo::PendingRemote<mojom::URLLoaderClient> client) {
   
+  // Zenith Native Adblock: Intercept resource request at socket creation
+  const GURL& request_url = request.url;
+  if (ZenithAdblockEngine::GetInstance()->ShouldBlockUrl(request_url, request.request_initiator)) {
+    VLOG(1) << "[Zenith Adblock] Blocked ad/tracker URL: " << request_url.spec();
+    mojo::Remote<mojom::URLLoaderClient> client_remote(std::move(client));
+    URLLoaderCompletionStatus status(net::ERR_BLOCKED_BY_CLIENT);
+    client_remote->OnComplete(status);
+    DeleteSelf();
+    return;
+  }
+
   url_request_ = url_request_context_->CreateRequest(
       request_url, request.priority, this, net_log_);
   
